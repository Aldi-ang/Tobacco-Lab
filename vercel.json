{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/auth/github/callback",
      "destination": "/api/index.ts"
    },
    {
      "source": "/auth/github/callback/",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/|auth/github/callback).*)",
      "destination": "/index.html"
    }
  ]
}
